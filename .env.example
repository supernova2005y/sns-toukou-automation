# このファイルを .env にコピーして値を入れる。.env は GitHub に上げない（.gitignore 済み）

# --- Instagram（プロアカウントが必要。手順は docs/セットアップ.md） ---
# unified: Unified Login（新しいアプリはこちら。既定）／ instagram: 旧 Instagram ログイン方式
IG_LOGIN=unified
# 取得先：Meta for Developers（https://developers.facebook.com/）のアプリ →「API setup with Unified login」でトークンを生成
# IG_USER_ID は Instagram アカウントのID、IG_ACCESS_TOKEN はシステムユーザーアクセストークン（期限なし。漏れたらすぐ無効にする）
IG_USER_ID=
IG_ACCESS_TOKEN=
# Meta のAPIバージョン。公式ドキュメントで最新を確認して合わせる
IG_API_VERSION=v23.0

# --- X（OAuth 1.0a。アプリの権限は Read and Write にする） ---
# 取得先：X Developer Console（https://developer.x.com/）のアプリで API Key・Access Token を作る
# 権限を Read and write にしてから Access Token を作る（権限を変えたら作り直す）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- 画像の置き場所（任意。S3 互換のクラウドストレージ。手順は docs/セットアップ.md） ---
# 使うときは pip install -e ".[storage]"。バケットは非公開のまま使う（投稿の直前に期限つきURLを作る）
# 取得先（Cloudflare R2 の場合）：Cloudflare のダッシュボードでバケットを作り、R2 の API トークンを作る（そのバケットだけの読み書き）
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Cloudflare R2 などは必須（https://<アカウントID>.r2.cloudflarestorage.com の形）。AWS S3 なら空
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto

# --- X の文面の下書き（任意。生成AI。手順は docs/セットアップ.md） ---
# 使うときは pip install -e ".[llm]"。下書きを作るたびに料金がかかる（投稿はしない）
# gemini（既定）か claude
LLM_PROVIDER=gemini
# 取得先：Gemini は Google AI Studio、Claude は Claude Console で API キーを作る（どちらか一方でよい）
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# モデル名。空なら既定（gemini-3.8-flash / claude-opus-5-5）。公式ドキュメントで最新を確認して合わせる
GEMINI_MODEL=
CLAUDE_MODEL=
